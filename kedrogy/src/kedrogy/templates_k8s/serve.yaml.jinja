apiVersion: apps/v1
kind: Deployment
metadata:
  name: serve-{{ model_id }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: serve-{{ model_id }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: serve-{{ model_id }}
    spec:
      volumes:
        - name: pvc-models
          persistentVolumeClaim:
            claimName: pvc-model-{{ model_id }}
      containers:
        - name: predict
          image: {{ image }}
          imagePullPolicy: Always
          workingDir: /app/{{ workingDir }}
          args: [
              "-m",
              "ysz.predict", 
              "data/06_models/best/", 
              "-p", 
              "{{ a_preprocess_fun }}",
            ]
          volumeMounts:
            - mountPath: /app/{{ workingDir }}/data/06_models/
              name: pvc-models
          ports:
            - containerPort: 8888
---
apiVersion: v1
kind: Service
metadata:
  name: serve-svc-{{ model_id }}
spec:
  selector:
    app.kubernetes.io/name: serve-{{ model_id }}
  ports:
    - name: predict
      protocol: TCP
      port: 8888
      targetPort: 8888
---

