# Copy to .env (ignored by Git and Docker). Generate fresh values locally.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGHOST=127.0.0.1
PGPORT=30001
PGDATABASE=mysite
PGUSER=kedrogy_app
PGPASSWORD=
KEDROGY_NAMESPACE=default
# Operator-approved image, preferably pinned by digest.
KEDROGY_ML_IMAGE=replace-with-an-approved-image-digest
KEDROGY_ML_IMAGE_ALIASES='["kedrogy-registry:5000/mykedro:latest"]'
# Supply build credentials in environment; Dockerfiles consume BuildKit secrets.
UV_INDEX_PRODIGY_USERNAME=
UV_INDEX_YSZ_USERNAME=
UV_INDEX_YSZ_PASSWORD=

# Optional local server/proxy settings. Deploy requires explicit HTTPS origins.
DJANGO_SETTINGS_MODULE=mysite.settings_local
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployment only: narrow networks containing the trusted web proxy.
# DJANGO_TRUSTED_PROXY_CIDRS=10.42.0.0/16
KEDROGY_TRAIN_TIMEOUT=3600
# Trusted operator configuration; never supplied by API clients.
KEDROGY_TRAIN_OPTIONS={}

# Local reader credentials remain separate from the application's database role.
KEDROGY_READER_ENV_FILE=.local/credentials/reader.env
KEDROGY_MAX_ANNOTATIONS=100000
KEDROGY_SERVE_TIMEOUT=300
KEDROGY_SERVE_INTERVAL=10
KEDROGY_SERVE_FRESHNESS=30

# The local k3d ingress publishes port 80 on host port 8081.
KEDROGY_ANNOTATION_URL=http://label.localhost:8081
KEDROGY_ANNOTATION_TIMEOUT=600
KEDROGY_ANNOTATION_FRESHNESS=45
KEDROGY_ANNOTATION_DATA_FRESHNESS=300
KEDROGY_CLEANUP_TIMEOUT=900
