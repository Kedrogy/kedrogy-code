# flytectl demo defaults
PGHOST=localhost
PGPORT=30001
PGUSER=postgres
PGPASSWORD=postgres
# compose.yaml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# different name for the default database that is created when the image is first started
POSTGRES_DB=mysite
# django needs these 
PGDATABASE=mysite
# django superuser
DJANGO_SUPERUSER_EMAIL=team@ysz.vc 
DJANGO_SUPERUSER_USERNAME=superuser
DJANGO_SUPERUSER_PASSWORD=secret
