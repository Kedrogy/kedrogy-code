{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "kedrogy-controller"
      },
      "automountServiceAccountToken": true
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "kedrogy-workload"
      },
      "automountServiceAccountToken": false
