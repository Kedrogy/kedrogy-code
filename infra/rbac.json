          ],
          "resourceNames": [
            "default"
          ],
          "verbs": [
            "get"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "kedrogy-namespace-identity-default"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "kedrogy-controller",
          "namespace": "default"
        }
      ],
      "roleRef": {
        "kind": "ClusterRole",
        "name": "kedrogy-namespace-identity-default",
        "apiGroup": "rbac.authorization.k8s.io"
