      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "configmaps",
            "persistentvolumeclaims",
            "services"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "patch",
            "update",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "patch",
            "update",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "batch"
          ],
          "resources": [
            "jobs"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "patch",
            "update",
            "delete"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods",
            "pods/log"
