{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "kedrogy-web"
      },
      "data": {
        "default.conf": "# Local profile. The manifest generator supplies the deployment variant.\nserver {\n    listen 8080;\n    server_name _;\n    root /usr/share/nginx/html;\n    client_max_body_size 2m;\n    location /static/ { alias /usr/share/nginx/static/; }\n    location = /legacy/ { proxy_pass http://mysite-svc:8000/; include /etc/nginx/proxy_params_kedrogy; }\n    location ~ ^/(api/|admin/|health/|i18n/|logout/|(?:en|ru)/|[0-9]+/|model/|new_|train_model/|serve_model/|stop_model/|predict_model/|delete_|label_dataset/|legacy_cleanup/|annotation/) {\n        proxy_pass http://mysite-svc:8000;\n        include /etc/nginx/proxy_params_kedrogy;\n    }\n    location / { try_files $uri $uri/ /index.html; }\n}\n",
        "proxy.conf": "proxy_set_header Host $host;\nproxy_set_header X-Forwarded-Proto http;\nproxy_set_header X-Forwarded-For $remote_addr;\nproxy_set_header Connection \"\";\nproxy_http_version 1.1;\nproxy_connect_timeout 5s;\nproxy_read_timeout 45s;\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "kedrogy-web"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "kedrogy-web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "kedrogy-web"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "web",
                "image": "kedrogy-registry:5000/web:dev",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 8080
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/conf.d/default.conf",
                    "subPath": "default.conf"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/proxy_params_kedrogy",
                    "subPath": "proxy.conf"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "kedrogy-web"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "kedrogy-web"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "kedrogy-web"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prodigy-svc"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "prodigy"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "kedrogy"
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "app.localhost",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "kedrogy-web",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "host": "label.localhost",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "prodigy-svc",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
